{
  "title": "Hang App Overview",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[1m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors",
      "targets": [
        {
          "expr": "rate(http_requests_total{status=~\"5..\"}[1m])"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}